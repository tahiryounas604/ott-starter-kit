{"author":"Tahir Younas","dependencies":{"express":"^5.1.0"},"description":"White-label OTT starter kit: TypeScript/Node backend, Roku (BrightScript), Android TV (Kotlin), Apple TV (Swift) clients and a React admin dashboard.","devDependencies":{"@types/express":"^5.0.0","@types/node":"^24.0.0","tsx":"^4.20.0","typescript":"^5.9.0"},"engines":{"node":">=24"},"license":"GPL-3.0","main":"dist/backend/src/server.js","name":"ott-starter-kit","scripts":{"build":"tsc -p tsconfig.json","dev":"tsx watch backend/src/server.ts","seed":"tsx backend/src/seed.ts","start":"node dist/backend/src/server.js","test":"npm run build && node --test dist/backend/test/*.test.js"},"type":"commonjs","version":"0.1.0"}